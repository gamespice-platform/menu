# The addons this one builds on are separate repositories. For local development,
# gs-bootstrap symlinks them (it reads these lines to know which):
#   ln -s ../../gs-core/addons/gs_core addons/gs_core
# Consumers copy every addon into their own project.
/addons/gs_core
/addons/gs_profile
/addons/gs_ui
/addons/gs_input
/addons/gs_settings
/addons/gs_save

